{
  "name": "dsh-plan-store",
  "version": "0.1.0",
  "description": "Database-backed plan store for DeepSeek Harness: plan_* tools, SQLite/FTS5 storage, project export and a kanban board in the web GUI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mops1k/dsh-plan-store.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "plan",
    "plan-store",
    "kanban"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./tool-restrict": {
      "types": "./lib/tool-restrict.d.ts",
      "default": "./lib/tool-restrict.js"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests client scripts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.18.0",
    "@types/react": "~18.3.1",
    "oxlint": "^1.83.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
